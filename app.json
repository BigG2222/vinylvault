{
  "expo": {
    "name": "VinylVault",
    "slug": "vinylvault",
    "scheme": "vinylvault",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "backgroundColor": "#070B14",
    "icon": "./assets/icon.png",
    "ios": {
      "bundleIdentifier": "com.vinylvault.app",
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "VinylVault uses the camera to photograph records and read barcodes for identification, grading and pressing checks.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "buildNumber": "1",
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": [
              "35F9.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": [
              "E174.1"
            ]
          }
        ]
      }
    },
    "android": {
      "package": "com.vinylvault.app",
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#070B14"
      },
      "permissions": [
        "android.permission.CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "backgroundColor": "#070B14"
        }
      ],
      "expo-status-bar",
      "expo-sharing",
      "expo-image",
      [
        "expo-camera",
        {
          "cameraPermission": "VinylVault uses the camera to photograph records and read barcodes for identification, grading and pressing checks.",
          "barcodeScannerEnabled": true,
          "recordAudioAndroid": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.4"
          },
          "android": {
            "usesCleartextTraffic": true,
            "buildArchs": [
              "arm64-v8a"
            ]
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "VinylVault opens photos you choose so it can identify and check a record.",
          "cameraPermission": "VinylVault uses the camera to photograph records and read barcodes for identification, grading and pressing checks."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "582ef688-267e-4bfd-a4cd-fd9ff83edb69"
      }
    },
    "owner": "bigglen888"
  }
}
