# Vision backend: "mock" (default; offline demo model, no network) or "proxy".
# With "proxy", the app POSTs photos to your server (see /server), which holds
# the model API key and the Discogs token. Never put API keys in EXPO_PUBLIC_*
# variables: they are bundled into the app binary.
EXPO_PUBLIC_VISION_PROVIDER=mock
EXPO_PUBLIC_VISION_PROXY_URL=http://192.168.4.73:8788

# RevenueCat public SDK keys (safe to ship). Leave blank to use the built-in
# simulated store, which lets you exercise the paywall without real purchases.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
