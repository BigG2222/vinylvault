{
  "expo": {
    "name": "VinylVault",
    "slug": "vinylvault",
    "scheme": "vinylvault",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "backgroundColor": "#070B14",
    "icon": "./assets/icon.png",
    "ios": {
      "bundleIdentifier": "com.vinylvault.app",
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "VinylVault uses the camera to photograph records and read barcodes for identification, grading and pressing checks."
      }
    },
    "android": {
      "package": "com.vinylvault.app",
      "versionCode": 1,
      "adaptiveIcon": { "foregroundImage": "./assets/adaptive-icon.png", "backgroundColor": "#070B14" },
      "permissions": ["android.permission.CAMERA"]
    },
    "plugins": [
      "expo-router",
      ["expo-splash-screen", { "image": "./assets/splash-icon.png", "imageWidth": 160, "backgroundColor": "#070B14" }],
      "expo-status-bar",
      "expo-sharing",
      "expo-image",
      [
        "expo-camera",
        {
          "cameraPermission": "VinylVault uses the camera to photograph records and read barcodes for identification, grading and pressing checks.",
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": { "deploymentTarget": "16.4" },
          "android": { "usesCleartextTraffic": true, "buildArchs": ["arm64-v8a"] }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "VinylVault opens photos you choose so it can identify and check a record.",
          "cameraPermission": "VinylVault uses the camera to photograph records and read barcodes for identification, grading and pressing checks."
        }
      ]
    ],
    "experiments": { "typedRoutes": true }
  }
}
