# Paste your Anthropic API key after the = (no spaces, no quotes)
ANTHROPIC_API_KEY=

# Optional: your Discogs personal access token, from
# https://www.discogs.com/settings/developers  ("Generate new token").
# Turns on real Discogs prices and release links. Leave blank for demo prices.
# Price suggestions also need your Discogs seller settings filled in.
DISCOGS_TOKEN=

# Optional overrides
# VISION_MODEL=claude-opus-5-5
# PORT=8788

# Optional: require this value in the app's X-App-Key header on /v1/* requests.
# Set the same value as EXPO_PUBLIC_APP_KEY in the app's .env. It keeps casual
# traffic off the server; it is not a strong secret (it ships inside the app).
# APP_KEY=

# Daily caps (defaults shown). Counters reset at midnight UTC and on restart.
# DEVICE_DAILY_SCANS=15
# IP_DAILY_SCANS=60
# TOTAL_DAILY_SCANS=300
# DEVICE_DAILY_PRICES=300
# Set to 1 when the server runs behind a hosting provider's proxy, so the
# per-network cap uses the real client address from X-Forwarded-For.
# TRUST_PROXY=1
